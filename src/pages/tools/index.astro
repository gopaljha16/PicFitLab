---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import CategoryIcon from '@/components/site/CategoryIcon.astro';
import AdSlot from '@/components/ads/AdSlot.astro';
import { ADSENSE_SLOTS } from '@/config/flags';
import { getActiveTools, type ToolCategory } from '@/config/registry';

const tools = getActiveTools('en');
const categories: Array<{ key: ToolCategory; title: string }> = [
  { key: 'fix', title: 'Upload Fixers & Checkers' },
  { key: 'compress', title: 'Image Compressors' },
  { key: 'resize', title: 'Resizers & Croppers' },
  { key: 'convert', title: 'Format Converters' },
  { key: 'privacy', title: 'Metadata & Privacy' },
];
---

<BaseLayout
  title="All Image Tools | PicFitLab"
  description="Browse all free, local browser-based image compression, resizing, conversion, and privacy tools on PicFitLab."
  canonicalPath="/tools/"
>
  <div class="container py-6 md:py-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'All Tools' }]} />
    <h1 class="mb-2 mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
      All Image Tools
    </h1>
    <p class="m-0 text-sm text-muted-foreground sm:text-base">
      Every tool runs locally in your browser without uploading your images to a server.
    </p>

    {
      categories.map((cat) => {
        const items = tools.filter((t) => t.category === cat.key);
        if (items.length === 0) return null;
        return (
          <section class="mt-10">
            <h2 class="m-0 flex items-center gap-2 text-lg font-semibold tracking-tight text-foreground">
              <CategoryIcon category={cat.key} size={18} />
              {cat.title}
            </h2>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {items.map((tool) => (
                <a
                  href={`/${tool.slug}/`}
                  class="flex flex-col gap-2 rounded-lg border border-border bg-card p-4 text-foreground no-underline shadow-xs transition-colors hover:border-foreground/25 hover:bg-accent/30 hover:no-underline"
                >
                  <div class="flex items-center gap-2 text-foreground">
                    <span class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-border bg-muted">
                      <CategoryIcon category={tool.engine === 'inspect' ? 'inspect' : tool.category} size={15} />
                    </span>
                    <strong class="text-sm font-semibold">{tool.shortLabel}</strong>
                  </div>
                  <p class="m-0 text-xs leading-relaxed text-muted-foreground">{tool.summary}</p>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }

    <AdSlot slotId={ADSENSE_SLOTS.directoryBanner} minHeightPx={100} />
  </div>
</BaseLayout>

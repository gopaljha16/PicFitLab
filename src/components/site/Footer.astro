---
import { SITE_CONFIG } from '@/config/flags';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <strong>{SITE_CONFIG.name}</strong> — {SITE_CONFIG.tagline}
      <p class="footer-note">
        Images are processed locally in your browser. Files are not uploaded to a processing server.
      </p>
    </div>
    <nav aria-label="Footer navigation" class="footer-links">
      <a href="/tools/">All Tools</a>
      <a href="/about/">About</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-surface);
    padding-block: var(--space-8);
    margin-top: var(--space-12);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: space-between;
  }

  .footer-note {
    margin: var(--space-1) 0 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      align-items: center;
    }
  }
</style>

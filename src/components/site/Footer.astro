---
import { SITE_CONFIG } from '@/config/flags';
---

<footer class="mt-16 border-t border-border bg-muted/30 py-8">
  <div class="container flex flex-col justify-between gap-4 md:flex-row md:items-center">
    <div>
      <div class="text-sm font-semibold text-foreground">
        {SITE_CONFIG.name} <span class="font-normal text-muted-foreground">— {SITE_CONFIG.tagline}</span>
      </div>
      <p class="mt-1 mb-0 text-xs text-muted-foreground">
        Images are processed locally in your browser. Files are never uploaded to a server.
      </p>
    </div>
    <nav aria-label="Footer navigation" class="flex flex-wrap gap-5 text-sm">
      <a href="/tools/" class="text-muted-foreground hover:text-foreground no-underline hover:underline">All Tools</a>
      <a href="/about/" class="text-muted-foreground hover:text-foreground no-underline hover:underline">About</a>
      <a href="/privacy/" class="text-muted-foreground hover:text-foreground no-underline hover:underline">Privacy</a>
      <a href="/terms/" class="text-muted-foreground hover:text-foreground no-underline hover:underline">Terms</a>
      <a href="/contact/" class="text-muted-foreground hover:text-foreground no-underline hover:underline">Contact</a>
    </nav>
  </div>
</footer>

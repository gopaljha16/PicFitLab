---
import { SITE_CONFIG } from '@/config/flags';

const navLinks = [
  { href: '/tools/', label: 'All Tools' },
  { href: '/compress-image/', label: 'Compress' },
  { href: '/resize-image/', label: 'Resize' },
  { href: '/jpg-to-png/', label: 'Convert' },
  { href: '/fix-image-upload-error/', label: 'Upload Fixer' },
  { href: '/remove-image-metadata/', label: 'Privacy' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="container flex h-14 items-center justify-between gap-4">
    <a
      href="/"
      class="inline-flex items-center gap-2.5 text-base font-semibold tracking-tight text-foreground no-underline hover:no-underline"
      aria-label={`${SITE_CONFIG.name} home`}
    >
      <img src="/favicon.svg" alt="" width="24" height="24" class="rounded-md" />
      <span>{SITE_CONFIG.name}</span>
    </a>

    <nav aria-label="Main navigation" class="hidden md:flex items-center gap-1">
      {
        navLinks.map((link) => {
          const active = currentPath === link.href;
          return (
            <a
              href={link.href}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm font-medium transition-colors no-underline hover:no-underline',
                active
                  ? 'bg-secondary text-foreground'
                  : 'text-muted-foreground hover:bg-accent hover:text-foreground',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <details class="relative md:hidden" id="mobile-nav-details">
      <summary
        class="btn btn-secondary list-none px-3 py-1.5 text-xs font-medium min-h-[36px] cursor-pointer [&::-webkit-details-marker]:hidden"
        aria-label="Toggle menu"
      >
        Menu
      </summary>
      <nav
        aria-label="Mobile navigation"
        class="absolute right-0 top-[calc(100%+8px)] z-50 flex w-56 flex-col gap-1 rounded-lg border border-border bg-popover p-1.5 shadow-md"
      >
        {
          navLinks.map((link) => {
            const active = currentPath === link.href;
            return (
              <a
                href={link.href}
                class:list={[
                  'flex min-h-[40px] items-center rounded-md px-3 py-2 text-sm font-medium no-underline hover:no-underline transition-colors',
                  active
                    ? 'bg-secondary text-foreground'
                    : 'text-muted-foreground hover:bg-accent hover:text-foreground',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const details = document.getElementById('mobile-nav-details');
    if (!details) return;
    document.addEventListener('click', (e) => {
      if (details.hasAttribute('open') && e.target instanceof Node && !details.contains(e.target)) {
        details.removeAttribute('open');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.hasAttribute('open')) {
        details.removeAttribute('open');
      }
    });
  })();
</script>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import RelatedTools from '@/components/tools/RelatedTools.astro';
import ToolWorkspaceShell from '@/components/tools/ToolWorkspaceShell';
import AdSlot from '@/components/ads/AdSlot.astro';
import { ADSENSE_SLOTS } from '@/config/flags';
import { getActiveTools, type ToolConfig } from '@/config/registry';
import { getToolContent } from '@/content/tools';

export function getStaticPaths() {
  return getActiveTools('en').map((tool) => ({
    params: { tool: tool.slug },
    props: { tool },
  }));
}

export interface Props {
  tool: ToolConfig;
}

const { tool } = Astro.props;
const content = getToolContent(tool.contentKey);
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  canonicalPath={`/${tool.slug}/`}
  noindex={!tool.indexable}
  allowAds={tool.sensitivity === 'general'}
>
  <div class="container py-6 md:py-8">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Tools', href: '/tools/' },
        { label: tool.shortLabel },
      ]}
    />

    <h1 class="mb-2 mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
      {tool.h1}
    </h1>
    <p class="m-0 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
      {tool.summary}
    </p>

    <noscript>
      <p class="mt-4 rounded-lg border border-amber-500/40 bg-amber-500/10 p-4 text-sm text-foreground">
        JavaScript is required to run local browser image processing. Enable JavaScript to use this
        tool.
      </p>
    </noscript>

    <ToolWorkspaceShell client:load tool={tool} />

    <section class="mt-10 max-w-3xl space-y-4">
      <h2 class="m-0 text-lg font-semibold tracking-tight text-foreground">
        How to use {tool.shortLabel}
      </h2>
      <ol class="m-0 space-y-1.5 pl-5 text-sm leading-relaxed text-muted-foreground">
        {content.howTo.map((step) => <li>{step}</li>)}
      </ol>
      {
        content.notes.map((note) => (
          <p class="m-0 text-sm leading-relaxed text-muted-foreground">{note}</p>
        ))
      }
      {
        content.faq.length > 0 && (
          <div class="pt-4">
            <h3 class="mb-3 mt-0 text-base font-semibold tracking-tight text-foreground">
              Frequently asked questions
            </h3>
            <div class="space-y-2">
              {content.faq.map((item) => (
                <details class="group rounded-lg border border-border bg-card px-4 py-3 text-sm">
                  <summary class="cursor-pointer font-medium text-foreground">{item.q}</summary>
                  <p class="mb-0 mt-2 leading-relaxed text-muted-foreground">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        )
      }
    </section>

    <RelatedTools relatedIds={tool.relatedIds} />

    {
      tool.sensitivity === 'general' && (
        <AdSlot slotId={ADSENSE_SLOTS.generalToolBottom} minHeightPx={100} />
      )
    }
  </div>
</BaseLayout>

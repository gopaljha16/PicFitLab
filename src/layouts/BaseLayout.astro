---
import '@/styles/tokens.css';
import '@/styles/global.css';
import Head, { type Props as HeadProps } from '@/components/seo/Head.astro';
import Header from '@/components/site/Header.astro';
import Footer from '@/components/site/Footer.astro';
import ConsentBanner from '@/components/ads/ConsentBanner';
import { ADSENSE_CLIENT, ADS_ENABLED } from '@/config/flags';

export interface Props extends HeadProps {
  lang?: string;
  allowAds?: boolean;
}

const { lang = 'en', allowAds = true, ...headProps } = Astro.props;
const showAdsOnPage = ADS_ENABLED && allowAds;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head {...headProps} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    {showAdsOnPage && <ConsentBanner client:idle adsEnabled={showAdsOnPage} adsenseClient={ADSENSE_CLIENT} />}
  </body>
</html>

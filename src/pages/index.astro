---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryIcon from '@/components/site/CategoryIcon.astro';
import ToolSearch from '@/components/tools/ToolSearch';
import RecentTools from '@/components/tools/RecentTools';
import { getActiveTools, getToolById } from '@/config/registry';
import { SITE_CONFIG } from '@/config/flags';

const allTools = getActiveTools('en');
const popularIds = [
  'fix-image-upload-error',
  'compress-image-to-50kb',
  'resize-image-to-600x600',
  'compress-image',
  'resize-image',
  'png-to-jpg',
  'remove-image-metadata',
  'image-size-checker',
];
const popularTools = popularIds
  .map((id) => getToolById(id))
  .filter((t): t is NonNullable<typeof t> => Boolean(t));

const searchItems = allTools.map((t) => ({
  id: t.id,
  slug: t.slug,
  shortLabel: t.shortLabel,
  summary: t.summary,
  category: t.category,
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.url,
  },
];
---

<BaseLayout
  title="Free Online Image Resizer, Compressor & Converter | PicFitLab"
  description="Resize, compress to exact KB targets, convert formats, and fix image upload errors locally in your browser without uploading files."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="border-b border-border bg-muted/30 py-10 md:py-14">
    <div class="container grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="flex flex-col items-start gap-5 lg:col-span-7">
        <span class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-muted-foreground shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          100% Browser-Local · No Server Uploads
        </span>

        <h1 class="m-0 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
          Image tools that never leave your browser.
        </h1>

        <p class="m-0 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
          Resize dimensions, compress to exact KB limits, convert formats, and strip GPS metadata
          inside a local Web Worker. Your files stay on your device.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/fix-image-upload-error/" class="btn btn-primary">
            Fix upload error
          </a>
          <a href="/tools/" class="btn btn-secondary">
            Explore all {allTools.length} tools
          </a>
        </div>

        <div class="w-full max-w-md pt-1">
          <ToolSearch client:idle tools={searchItems} />
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-1 text-xs font-medium text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Zero server uploads
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m13 2-3 7h7l-9 13 3-8H4z"/></svg>
            Instant Web Worker processing
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Free &amp; private
          </span>
        </div>
      </div>

      <div class="lg:col-span-5" aria-label="Sample technical verification report">
        <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
          <div class="flex items-center justify-between border-b border-border bg-muted/40 px-4 py-2.5">
            <div class="flex items-center gap-2">
              <span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-border" aria-hidden="true"></span>
              <span class="ml-1 font-mono text-xs text-muted-foreground">verification-report</span>
            </div>
            <span class="rounded border border-border bg-background px-2 py-0.5 font-mono text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
              PASS
            </span>
          </div>

          <div class="p-4">
            <table class="w-full border-collapse text-xs">
              <thead>
                <tr class="border-b border-border text-left text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                  <th class="pb-2 font-medium">Check</th>
                  <th class="pb-2 font-medium">Input</th>
                  <th class="pb-2 font-medium">Target</th>
                  <th class="pb-2 text-right font-medium">Output</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border font-mono tabular-nums">
                <tr>
                  <td class="py-2.5 font-sans font-medium text-foreground">Format</td>
                  <td class="py-2.5 text-muted-foreground">PNG</td>
                  <td class="py-2.5 text-muted-foreground">JPEG</td>
                  <td class="py-2.5 text-right font-medium text-emerald-600 dark:text-emerald-400">JPEG</td>
                </tr>
                <tr>
                  <td class="py-2.5 font-sans font-medium text-foreground">Dimensions</td>
                  <td class="py-2.5 text-muted-foreground">1920×1080</td>
                  <td class="py-2.5 text-muted-foreground">600×600</td>
                  <td class="py-2.5 text-right font-medium text-emerald-600 dark:text-emerald-400">600×600</td>
                </tr>
                <tr>
                  <td class="py-2.5 font-sans font-medium text-foreground">File size</td>
                  <td class="py-2.5 text-muted-foreground">2.40 MB</td>
                  <td class="py-2.5 text-muted-foreground">≤ 50 KB</td>
                  <td class="py-2.5 text-right font-medium text-emerald-600 dark:text-emerald-400">48.6 KB</td>
                </tr>
                <tr>
                  <td class="py-2.5 font-sans font-medium text-foreground">Metadata</td>
                  <td class="py-2.5 text-muted-foreground">EXIF + GPS</td>
                  <td class="py-2.5 text-muted-foreground">Stripped</td>
                  <td class="py-2.5 text-right font-medium text-emerald-600 dark:text-emerald-400">Clean</td>
                </tr>
              </tbody>
            </table>

            <div class="mt-4 grid grid-cols-3 gap-2 border-t border-border pt-3 text-center">
              <div class="rounded-md bg-muted/50 px-2 py-2">
                <div class="font-mono text-base font-semibold tabular-nums text-foreground">{allTools.length}</div>
                <div class="text-[11px] text-muted-foreground">Local tools</div>
              </div>
              <div class="rounded-md bg-muted/50 px-2 py-2">
                <div class="font-mono text-base font-semibold tabular-nums text-foreground">0 B</div>
                <div class="text-[11px] text-muted-foreground">Uploaded</div>
              </div>
              <div class="rounded-md bg-muted/50 px-2 py-2">
                <div class="font-mono text-base font-semibold tabular-nums text-foreground">100%</div>
                <div class="text-[11px] text-muted-foreground">Verified</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <RecentTools client:idle tools={searchItems} />

  <section class="container py-10">
    <div class="mb-5 flex items-baseline justify-between gap-4">
      <h2 class="m-0 text-xl font-semibold tracking-tight text-foreground">Popular tools</h2>
      <a href="/tools/" class="text-sm font-medium text-muted-foreground hover:text-foreground no-underline hover:underline">
        View all →
      </a>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        popularTools.map((tool) => (
          <a
            href={`/${tool.slug}/`}
            class="group flex flex-col gap-2.5 rounded-lg border border-border bg-card p-4 text-foreground no-underline shadow-xs transition-colors hover:border-foreground/25 hover:bg-accent/30 hover:no-underline"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border bg-muted text-foreground">
                <CategoryIcon category={tool.engine === 'inspect' ? 'inspect' : tool.category} size={16} />
              </span>
              <span class="badge">{tool.category}</span>
            </div>
            <h3 class="m-0 text-sm font-semibold text-foreground">{tool.shortLabel}</h3>
            <p class="m-0 text-xs leading-relaxed text-muted-foreground">{tool.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container py-4">
    <div class="grid grid-cols-1 items-center gap-6 rounded-xl border border-border bg-card p-6 shadow-xs md:grid-cols-12">
      <div class="space-y-3 md:col-span-6">
        <span class="badge">Flagship workflow</span>
        <h2 class="m-0 text-xl font-semibold tracking-tight text-foreground">Upload Error Fixer</h2>
        <p class="m-0 text-sm leading-relaxed text-muted-foreground">
          Portal rejecting your photo? Combine target format, exact pixel dimensions, and maximum KB
          size in one pass, then verify the actual exported file before uploading.
        </p>
        <div class="pt-1">
          <a href="/fix-image-upload-error/" class="btn btn-primary">Open Upload Error Fixer</a>
        </div>
      </div>
      <div
        class="overflow-x-auto rounded-lg border border-border bg-muted/30 p-3 md:col-span-6"
        tabindex="0"
        role="region"
        aria-label="Illustrative technical verification report"
      >
        <table class="w-full border-collapse text-xs">
          <caption class="mb-2 text-left text-[11px] font-medium text-muted-foreground">
            Illustrative technical verification report
          </caption>
          <thead>
            <tr class="border-b border-border text-left text-muted-foreground">
              <th class="p-2 font-medium">Check</th>
              <th class="p-2 font-medium">Input</th>
              <th class="p-2 font-medium">Required</th>
              <th class="p-2 font-medium">Result</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border font-mono tabular-nums">
            <tr>
              <td class="p-2 font-sans font-medium text-foreground">Format</td>
              <td class="p-2 text-muted-foreground">PNG</td>
              <td class="p-2 text-muted-foreground">JPEG</td>
              <td class="p-2 text-emerald-600 dark:text-emerald-400">JPEG — pass</td>
            </tr>
            <tr>
              <td class="p-2 font-sans font-medium text-foreground">Dimensions</td>
              <td class="p-2 text-muted-foreground">1920×1080</td>
              <td class="p-2 text-muted-foreground">600×600</td>
              <td class="p-2 text-emerald-600 dark:text-emerald-400">600×600 — pass</td>
            </tr>
            <tr>
              <td class="p-2 font-sans font-medium text-foreground">File size</td>
              <td class="p-2 text-muted-foreground">2,400,000 B</td>
              <td class="p-2 text-muted-foreground">≤ 50,000 B</td>
              <td class="p-2 text-emerald-600 dark:text-emerald-400">48,600 B — pass</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="container py-10">
    <h2 class="mb-5 mt-0 text-xl font-semibold tracking-tight text-foreground">How local processing works</h2>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <div class="rounded-lg border border-border bg-card p-5 shadow-xs">
        <div class="mb-2 font-mono text-xs font-medium text-muted-foreground">01</div>
        <h3 class="m-0 text-sm font-semibold text-foreground">Choose an image</h3>
        <p class="mb-0 mt-1.5 text-sm leading-relaxed text-muted-foreground">
          Select or drop a local JPG, PNG, or WebP file. Nothing is sent to a remote server.
        </p>
      </div>
      <div class="rounded-lg border border-border bg-card p-5 shadow-xs">
        <div class="mb-2 font-mono text-xs font-medium text-muted-foreground">02</div>
        <h3 class="m-0 text-sm font-semibold text-foreground">Set requirements</h3>
        <p class="mb-0 mt-1.5 text-sm leading-relaxed text-muted-foreground">
          Pick pixel dimensions, target file size in KB, output format, or metadata removal.
        </p>
      </div>
      <div class="rounded-lg border border-border bg-card p-5 shadow-xs">
        <div class="mb-2 font-mono text-xs font-medium text-muted-foreground">03</div>
        <h3 class="m-0 text-sm font-semibold text-foreground">Verify &amp; download</h3>
        <p class="mb-0 mt-1.5 text-sm leading-relaxed text-muted-foreground">
          Inspect the actual output bytes, dimensions, and format before saving to your device.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

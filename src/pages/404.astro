---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | PicFitLab"
  description="The page you requested could not be found on PicFitLab."
  noindex={true}
>
  <div class="container not-found">
    <h1>404 — Page Not Found</h1>
    <p>The tool or page you requested does not exist or may have moved.</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Go to Homepage</a>
      <a href="/tools/" class="btn btn-secondary">Browse All Tools</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-12);
    max-width: 600px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>

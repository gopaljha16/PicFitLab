---
import { SITE_CONFIG } from '@/config/flags';

const navLinks = [
  { href: '/tools/', label: 'All Tools' },
  { href: '/compress-image/', label: 'Compress' },
  { href: '/resize-image/', label: 'Resize' },
  { href: '/jpg-to-png/', label: 'Convert' },
  { href: '/fix-image-upload-error/', label: 'Upload Fixer' },
  { href: '/remove-image-metadata/', label: 'Privacy' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE_CONFIG.name} home`}>
      <img src="/favicon.svg" alt="" width="28" height="28" />
      <span class="brand-name">{SITE_CONFIG.name}</span>
    </a>

    <nav aria-label="Main navigation" class="desktop-nav">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu" id="mobile-nav-details">
      <summary class="btn btn-secondary mobile-menu-toggle" aria-label="Toggle menu">
        Menu
      </summary>
      <nav aria-label="Mobile navigation" class="mobile-nav-panel">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={['mobile-nav-link', { active: currentPath === link.href }]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const details = document.getElementById('mobile-nav-details');
    if (!details) return;
    document.addEventListener('click', (e) => {
      if (details.hasAttribute('open') && e.target instanceof Node && !details.contains(e.target)) {
        details.removeAttribute('open');
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.hasAttribute('open')) {
        details.removeAttribute('open');
      }
    });
  })();
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
    font-size: 1.125rem;
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
    background-color: var(--color-surface);
    text-decoration: none;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu-toggle {
    list-style: none;
    font-size: 0.875rem;
  }

  .mobile-menu-toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    width: 220px;
    background-color: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    z-index: 50;
  }

  .mobile-nav-link {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .mobile-nav-link.active {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>

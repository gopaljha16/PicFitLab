---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import { SITE_CONFIG } from '@/config/flags';
---

<BaseLayout
  title="Privacy Policy | PicFitLab"
  description="How PicFitLab handles local browser image processing, static hosting, and user privacy."
  canonicalPath="/privacy/"
>
  <div class="container legal-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />
    <h1>Privacy Policy</h1>
    <p>
      <strong>Local image processing:</strong> {SITE_CONFIG.name} processes images directly inside
      your web browser. Your image files, pixel data, and EXIF metadata are not uploaded to an
      image-processing server.
    </p>
    <h2>Static hosting and infrastructure</h2>
    <p>
      This website is served as static files. Standard web hosting infrastructure may process
      transient connection metadata (such as IP address and request headers) to deliver pages
      securely.
    </p>
    <h2>Local browser storage &amp; consent withdrawal</h2>
    <p>
      Optional interface preferences (recent tools) and advertising consent choices may be saved
      in your browser&apos;s local storage. Raw photos and personal documents are not persisted in
      browser storage by default.
    </p>
    <p>
      <button type="button" id="reset-local-data-btn" class="btn btn-secondary">
        Clear saved preferences &amp; reset ad consent
      </button>
      <span id="reset-local-data-status" style="margin-left: 12px; font-size: 0.875rem;"></span>
    </p>
    <script is:inline>
      (() => {
        const btn = document.getElementById('reset-local-data-btn');
        const status = document.getElementById('reset-local-data-status');
        if (!btn) return;
        btn.addEventListener('click', () => {
          try {
            localStorage.removeItem('picfitlab_consent_v1');
            localStorage.removeItem('picfitlab_recent_tools');
            localStorage.removeItem('picfitlab_favorite_tools');
            window.dispatchEvent(new CustomEvent('picfitlab:consent-changed', { detail: 'unset' }));
            if (status) status.textContent = 'Local preferences and consent choice cleared.';
          } catch {
            if (status) status.textContent = 'Browser storage is unavailable.';
          }
        });
      })();
    </script>
    <h2>Contact</h2>
    <p>
      For privacy questions, contact <a href={`mailto:${SITE_CONFIG.supportEmail}`}>{SITE_CONFIG.supportEmail}</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .legal-page {
    padding-block: var(--space-4) var(--space-8);
    max-width: 760px;
  }
</style>
